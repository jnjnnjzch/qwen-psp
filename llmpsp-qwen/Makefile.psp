PROJECT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
UPSTREAM := $(abspath $(PROJECT)/../LLMPSP)
.DEFAULT_GOAL := all
include $(PROJECT)/sources.mk

TARGET = Qwen3PSP
OBJS = $(CORE_SOURCES:%.c=objects/%.o) objects/main.o objects/compat/falcon_frontend.o \
 objects/legacy_ui.o objects/legacy_prefetch.o
ifeq ($(AUTOTEST),1)
TARGET = Qwen3Test
endif

INCDIR = $(PROJECT)/compat $(PROJECT)/include $(PROJECT)/src $(UPSTREAM)/include \
 $(UPSTREAM)/qwen/q4_0/.work/psp-deps/include
LIBDIR = $(UPSTREAM)/qwen/q4_0/.work/psp-deps/lib
CFLAGS = -O3 -G0 -Wall -Wextra -std=c99 -fno-math-errno -DFALCON_QWEN3 -DFALCON_NO_PREFETCH -MMD -MP
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
ASFLAGS = $(CFLAGS)
LIBS = -lpcre2-8 -lpsppower -lm
BUILD_PRX = 1
PSP_FW_VERSION = 660
PSP_LARGE_MEMORY = 0
EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = Qwen3 0.6B Q4_0
PSP_EBOOT_ICON = $(UPSTREAM)/ICON0.PNG

objects/%.o: $(PROJECT)/%.c
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@

ifeq ($(AUTOTEST),1)
objects/main.o: $(PROJECT)/tests/psp_autotest.c
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@
else
objects/main.o: $(UPSTREAM)/src/main_psp.c $(PROJECT)/compat/falcon_h1.h
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@
endif

objects/legacy_ui.o: $(UPSTREAM)/src/falcon_ui.c
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@

objects/legacy_prefetch.o: $(UPSTREAM)/src/falcon_prefetch_psp.c $(PROJECT)/compat/falcon_h1.h
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@

PSPSDK := $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak
-include $(OBJS:.o=.d)
