PROJECT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
.DEFAULT_GOAL := all
TARGET = Qwen3PSP
OBJS = falcon_h1.o falcon_q4_psp.o falcon_prefetch_psp.o falcon_tokenizer.o falcon_sampler.o

ifeq ($(AUTOTEST),1)
TARGET = Qwen3Test
OBJS += psp_autotest.o
else
OBJS += main_psp.o falcon_ui.o
endif

INCDIR = $(PROJECT)include $(PROJECT).work/psp-deps/include
LIBDIR = $(PROJECT).work/psp-deps/lib
CFLAGS = -O3 -G0 -Wall -Wextra -std=c99 -fno-math-errno -DFALCON_QWEN3 -DFALCON_SCALAR_ATTENTION -DFALCON_NO_PREFETCH
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
ASFLAGS = $(CFLAGS)
LIBS = -lpcre2-8 -lpsppower -lm
BUILD_PRX = 1
PSP_FW_VERSION = 660
PSP_LARGE_MEMORY = 0
EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = Qwen3 0.6B Q4_0
PSP_EBOOT_ICON = $(PROJECT)ICON0.PNG

psp_autotest.o: $(PROJECT)tests/psp_autotest.c $(PROJECT)include/falcon_h1.h
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@

%.o: $(PROJECT)src/%.c $(PROJECT)include/falcon_h1.h $(PROJECT)include/falcon_ui.h
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@

PSPSDK := $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak
