PROJECT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
.DEFAULT_GOAL := all
include $(PROJECT)tools/sources.mk

TARGET = Qwen3PSP
OBJS = $(CORE_SOURCES:%.c=objects/%.o)
ifeq ($(AUTOTEST),1)
TARGET = Qwen3Test
OBJS += objects/tests/psp_autotest.o
else
OBJS += objects/src/main_psp.o objects/src/falcon_frontend.o objects/src/falcon_ui.o \
 objects/src/falcon_prefetch_psp.o
endif

INCDIR = $(PROJECT)include $(PROJECT)src $(PROJECT).work/psp-deps/include
LIBDIR = $(PROJECT).work/psp-deps/lib
CFLAGS = -O3 -G0 -Wall -Wextra -std=c99 -fno-math-errno -DFALCON_QWEN3 -DFALCON_NO_PREFETCH -MMD -MP
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
ASFLAGS = $(CFLAGS)
LIBS = -lpcre2-8 -lpsppower -lm
BUILD_PRX = 1
PSP_FW_VERSION = 660
PSP_LARGE_MEMORY = 0
EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = Qwen3 0.6B Q4_0
PSP_EBOOT_ICON = $(PROJECT)ICON0.PNG

objects/%.o: $(PROJECT)%.c
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@

PSPSDK := $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak
-include $(OBJS:.o=.d)
