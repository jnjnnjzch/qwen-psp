QWEN_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
ROOT := $(abspath $(QWEN_DIR)/../..)
.DEFAULT_GOAL := all
TARGET = Qwen3PSP
OBJS = main.o falcon_ui.o falcon_h1.o falcon_q4_psp.o falcon_prefetch_psp.o falcon_tokenizer.o falcon_sampler.o

ifeq ($(AUTOTEST),1)
TARGET = Qwen3Test
endif

INCDIR = $(ROOT)/include $(QWEN_DIR)/.work/psp-deps/include
LIBDIR = $(QWEN_DIR)/.work/psp-deps/lib
CFLAGS = -O3 -G0 -Wall -Wextra -std=c99 -fno-math-errno -DFALCON_QWEN3 -DFALCON_SCALAR_ATTENTION -DFALCON_NO_PREFETCH
CXXFLAGS = $(CFLAGS) -fno-exceptions -fno-rtti
ASFLAGS = $(CFLAGS)
LIBS = -lpcre2-8 -lpsppower -lm
BUILD_PRX = 1
PSP_FW_VERSION = 660
PSP_LARGE_MEMORY = 0
EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = Qwen3 0.6B Q4_0
PSP_EBOOT_ICON = $(ROOT)/ICON0.PNG

main.o: $(ROOT)/include/falcon_h1.h $(ROOT)/include/falcon_ui.h

ifeq ($(AUTOTEST),1)
main.o: $(QWEN_DIR)/autotest.c
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@
else
main.o: $(ROOT)/src/main_psp.c
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@
endif

%.o: $(ROOT)/src/%.c $(ROOT)/include/falcon_h1.h $(QWEN_DIR)/model.inc $(QWEN_DIR)/tokenizer.inc
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@

PSPSDK := $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak
