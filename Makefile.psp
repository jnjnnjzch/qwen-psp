PROJECT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
.DEFAULT_GOAL := all

TARGET = DotQ4Bench
OBJS = objects/main_psp.o objects/engine.o objects/scalar.o objects/custom_vfpu.o \
       objects/custom_vh2f.o objects/dot_vh2f.o objects/llmpsp_vfpu.o
INCDIR = $(PROJECT)include
CFLAGS = -O3 -G0 -Wall -Wextra -Werror -std=c99 -fno-math-errno -fno-lto -MMD -MP
ASFLAGS = $(CFLAGS)
LIBS = -lpsppower -lpsprtc -lz -lm
BUILD_PRX = 1
PSP_FW_VERSION = 550
PSP_LARGE_MEMORY = 0
EXTRA_TARGETS = EBOOT.PBP
PSP_EBOOT_TITLE = DOT Q4 / PSP Compute Lab
PSP_EBOOT_ICON = $(PROJECT)build/assets/ICON0.PNG
SFOFLAGS = -s PSP_SYSTEM_VER=5.50
LDFLAGS = -Wl,-Map,DotQ4Bench.map

objects/%.o: $(PROJECT)/src/%.c $(PROJECT)/Makefile.psp
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) $(addprefix -I,$(INCDIR)) -c $< -o $@

objects/scalar.o: CFLAGS += -fno-tree-vectorize -fno-tree-slp-vectorize
objects/custom_vfpu.o: CFLAGS += -fstack-usage -DBENCH_CUSTOM_VH2F=0

objects/custom_vh2f.o: $(PROJECT)/src/custom_vfpu.c $(PROJECT)/Makefile.psp
	mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -fstack-usage -DBENCH_CUSTOM_VH2F=1 $(addprefix -I,$(INCDIR)) -c $< -o $@

PARAM.SFO: $(PROJECT)/Makefile.psp

PSPSDK := $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak
-include $(OBJS:.o=.d)
